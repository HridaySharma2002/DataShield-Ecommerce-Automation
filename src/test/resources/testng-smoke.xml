<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Test Suite" verbose="1">
    <listeners>
        <listener class-name="com.datashield.automation.listeners.TestListener"/>
    </listeners>
    <test name="Smoke Navigation & Login Verification">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.datashield.automation.tests.SmokeTest"/>
        </classes>
    </test>
</suite>
