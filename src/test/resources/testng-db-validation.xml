<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Database Validation Suite" verbose="1">
    <listeners>
        <listener class-name="com.datashield.automation.listeners.TestListener"/>
    </listeners>
    <test name="Selenium & SQL Database Integration Tests">
        <groups>
            <run>
                <include name="db_validation"/>
            </run>
        </groups>
        <classes>
            <class name="com.datashield.automation.tests.DatabaseValidationTest"/>
        </classes>
    </test>
</suite>
